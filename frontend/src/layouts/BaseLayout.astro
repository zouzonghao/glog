---
import '../styles/style.css';
import Notification from '../components/Notification.astro';
import { ClientRouter } from 'astro:transitions';

export interface Props {
	title: string;
	description?: string;
}

const { title, description } = Astro.props;
const { isLoggedIn } = Astro.locals;

// Fetch public site settings for all pages
let siteTitle = 'Glog';
let siteDescription = description || 'A Glog site';
let favicon = '/pic/favicon.ico'; // Default favicon

try {
    const settingsResponse = await fetch(`${import.meta.env.PUBLIC_API_URL}/api/public-settings`);
    if (settingsResponse.ok) {
        const settingsData = await settingsResponse.json();
        const settings = settingsData.settings;
        siteTitle = settings.site_title || siteTitle;
        siteDescription = description || settings.site_description || siteDescription;
        favicon = settings.favicon || favicon;
    }
} catch (error) {
    console.error("Could not fetch public settings:", error);
}

const isIndexOrSearchPage = Astro.url.pathname === '/' || Astro.url.pathname === '/search';
const { view: currentView } = Astro.locals;
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content={siteDescription} />
    <title>{title} | {siteTitle}</title>
    
    <script is:inline>
        (function() {
            const savedTheme = localStorage.getItem("theme");
            const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
            let theme = savedTheme || (prefersDark ? "dark" : "light");
            
            // If there's no saved theme, save the determined theme to localStorage.
            if (!savedTheme) {
                localStorage.setItem("theme", theme);
            }

            // Explicitly add the correct theme class.
            document.documentElement.classList.remove('light', 'dark');
            document.documentElement.classList.add(theme);
        })();
    </script>

    <link rel="icon" href={favicon} type="image/x-icon">
    
    <slot name="head" />
    <ClientRouter />
</head>
<body id="top">
    <div class="main-wrapper">
        <header class="main-header">
            <div class="header-left">
                <input type="checkbox" id="menu-toggle" class="nav-toggle-checkbox">
                <label for="menu-toggle" class="menu-toggle" aria-label="Toggle menu">
                    <div class="hamburger-box">
                        <div class="hamburger-inner"></div>
                    </div>
                </label>
                <div class="site-info">
                    <a href="/" class="site-title">{siteTitle}</a>
                    <nav class="main-nav" id="main-nav">
                        <ul>
                            <li><a href="/">主页</a></li>
                            {isLoggedIn ? (
                                <>
                                    <li><a href="/admin/editor">新建</a></li>
                                    <li><a href="/admin/">管理</a></li>
                                    <li><a href="/admin/setting/">设置</a></li>
                                    <li><a href="#" id="logout-link">登出</a></li>
                                </>
                            ) : (
                                <li><a href="/login">登录</a></li>
                            )}
                        </ul>
                    </nav>
                </div>
            </div>
            <div class="header-right">
                <form id="search-form" action="/search" method="get" class="search-form" style="view-transition-name: search-form;">
                    <input type="search" name="q" placeholder="搜索..." class="search-input">
                    <button type="submit" id="search-button" class="search-button" aria-label="Search">
                        <img src="/pic/search.png" alt="Search" class="search-icon">
                    </button>
                </form>
                {isIndexOrSearchPage && (
                    <a href={Astro.url.pathname + (currentView === 'cards' ? '?view=list' : '?view=cards')} class="theme-toggle" title="切换视图">
                        {/* SVGs remain the same */}
                        {currentView === 'cards' ? (
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
                        ) : (
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                        )}
                    </a>
                )}
                <a href="#" id="theme-toggle" class="theme-toggle" title="Toggle theme" transition:persist>
                    <svg class="sun-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
                    <svg class="moon-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
                </a>
            </div>
        </header>
        
        <main>
            <slot />
        </main>
        
        <footer class="main-footer">
            <p>&copy; {siteTitle}. Powered by Glog.</p>
        </footer>
    </div>
    <a href="#top" id="back-to-top" class="back-to-top" title="Back to top">&uarr;</a>
    
    <Notification />
    
    <slot name="scripts" />
    <script src="../scripts/main.ts"></script>
    <script src="../scripts/theme-toggle.ts"></script>
</body>
</html>
<script is:inline>
  function showSessionNotification() {
    const notificationJSON = sessionStorage.getItem('glog_notification');
    if (notificationJSON) {
      try {
        const notification = JSON.parse(notificationJSON);
        const event = new CustomEvent('show-notification', { detail: notification });
        document.dispatchEvent(event);
      } catch (e) {
        console.error("Could not parse notification from sessionStorage", e);
      } finally {
        sessionStorage.removeItem('glog_notification');
      }
    }
  }

  // Run on initial page load
  document.addEventListener('DOMContentLoaded', showSessionNotification);
  // Run on subsequent page navigations (Astro View Transitions)
  document.addEventListener('astro:after-swap', showSessionNotification);
</script>

<style is:global>
  ::view-transition-group(*) {
    animation-duration: 0.45s;
  }
  @keyframes zero {
    0% {
        opacity: 0;
    }
    100% {
        opacity: 0;
    }      
}

  @keyframes fadeIn {
    0% {
        opacity: 0;
    }
    40% {
        opacity: 0.8;
    }
    100% {
        opacity: 1;
    }
  }

  @keyframes slideInFromRight {
    from {
      opacity: 0;
      transform: translateX(40px);
    }
    to {
      transform: translateX(0);
    }
  }

</style>
<script>
  function setSearchInputValue() {
    const searchInput = document.querySelector('.search-input') as HTMLInputElement;
    if (!searchInput) return;

    const urlParams = new URLSearchParams(window.location.search);
    const query = urlParams.get('q');

    searchInput.value = query || '';
  }

  // Run on initial page load
  document.addEventListener('astro:page-load', setSearchInputValue);
</script>