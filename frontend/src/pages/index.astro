---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import PostCards from '../components/PostCards.astro';
import Pagination from '../components/Pagination.astro';
import { getPosts } from '../services/api';
import type { Post } from '../services/api';
import '../styles/cards.css';

// Get view from URL, default to 'list'
const view = Astro.url.searchParams.get('view') || 'list';

// Get page from URL for pagination
const page = parseInt(Astro.url.searchParams.get('page') || '1', 10);

// Fetch posts from your Go backend
const data = await getPosts(page);
const posts: Post[] = data?.posts || [];
const pagination = data?.pagination;

const title = "主页";
---

<BaseLayout title={title}>
    {view === 'list' ? (
        <PostList posts={posts} />
    ) : (
        <PostCards posts={posts} />
    )}

    {pagination && (
        <Pagination pagination={pagination} baseUrl="/" />
    )}
</BaseLayout>
