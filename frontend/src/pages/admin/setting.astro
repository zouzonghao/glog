---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSettings } from '../../services/api';
import SettingsForm from '../../components/SettingsForm.svelte';
import BackupManager from '../../components/BackupManager.svelte';
import SettingsModal from '../../components/SettingsModal.svelte';
import AiLogsModal from '../../components/AiLogsModal.svelte';

const settings = await getSettings(Astro.cookies);

const aiFields = [
  { name: 'openai_base_url', label: 'OpenAI Compatible Base URL', type: 'text' },
  { name: 'openai_token', label: 'OpenAI Compatible Token', type: 'password', placeholder: '留空则不修改' },
  { name: 'openai_model', label: 'OpenAI Compatible 模型', type: 'text' },
];

const imageApiFields = [
    { name: 'imageapi_url', label: 'ImageAPI URL', type: 'text' },
    { name: 'imageapi_token', label: 'ImageAPI Token', type: 'password', placeholder: '留空则不修改' },
    { name: 'imageapi_model', label: 'ImageAPI 模型', type: 'text' },
];

const githubFields = [
    { name: 'github_repo', label: '仓库名 (格式: user/repo)', type: 'text' },
    { name: 'github_branch', label: '分支名', type: 'text' },
    { name: 'github_token', label: 'Personal Access Token', type: 'password', placeholder: '留空则不修改' },
    { name: 'github_interval', label: '备份间隔（小时），0 表示不启用', type: 'number', min: 0 },
];

const webdavFields = [
    { name: 'webdav_url', label: '服务器地址', type: 'text' },
    { name: 'webdav_user', label: '账号', type: 'text' },
    { name: 'webdav_password', label: '密码', type: 'password', placeholder: '留空则不修改' },
    { name: 'webdav_interval', label: '备份间隔（小时），0 表示不启用', type: 'number', min: 0 },
];
---
<BaseLayout title="站点设置">
    <div class="setting-header">
        <h2 class="group-title">站点信息</h2>
    </div>
    <SettingsForm client:load settings={settings} />

    <div class="setting-header setting-header-separated">
        <h2 class="group-title">AI 集成</h2>
    </div>
    <div class="backup-actions settings-form-group-spaced">
        <SettingsModal client:visible title="AI 功能设置" formId="ai-settings-form" settings={settings} fields={aiFields} testEndpoint="/api/settings/test-ai">
            🔧 基本模型
        </SettingsModal>
        <SettingsModal client:visible title="AI 封面功能设置 (ImageAPI)" formId="imageapi-settings-form" settings={settings} fields={imageApiFields} testEndpoint="/api/settings/test-imageapi">
            🎨 AI 封面模型
        </SettingsModal>
        <AiLogsModal client:visible />
    </div>

    <div class="setting-header setting-header-separated">
        <h2 class="group-title">备份与恢复</h2>
    </div>
    <div class="backup-actions settings-form-group-spaced">
        <SettingsModal client:visible title="GitHub 备份设置" formId="github-settings-form" settings={settings} fields={githubFields} testEndpoint="/api/settings/test-github" backupEndpoint="/api/backup/github-now">
            🔧 GitHub 备份
        </SettingsModal>
        <SettingsModal client:visible title="WebDAV 备份设置" formId="webdav-settings-form" settings={settings} fields={webdavFields} testEndpoint="/api/settings/test-webdav" backupEndpoint="/api/backup/webdav-now">
            🔧 WebDAV 备份
        </SettingsModal>
        <BackupManager client:load />
    </div>
</BaseLayout>