---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Pagination from '../../components/Pagination.astro';
import type { Post } from '../../services/api';
import { getAdminPosts } from '../../services/api';
import AdminManager from '../../components/AdminManager.svelte';

// Fetch posts for admin view
const page = parseInt(Astro.url.searchParams.get('page') || '1', 10);
const pageSize = parseInt(Astro.url.searchParams.get('pageSize') || '10', 10);
const pageSizeOptions = [10, 20, 50];
const query = Astro.url.searchParams.get('q') || '';

const data = await getAdminPosts(page, pageSize, query, Astro.cookies);
const posts: Post[] = data?.posts || [];
const pagination = data?.pagination;
---
<BaseLayout title="后台管理">
    <div class="admin-header">
        <h2 class="group-title">文章管理</h2>
        <form id="admin-search-form" action="/admin" method="get" class="search-form admin-search-form">
            <input type="search" name="q" placeholder="搜索文章..." class="search-input" value={query}>
            <button type="submit" class="search-button" aria-label="Search">
                <img src="/pic/search.png" alt="Search" class="search-icon">
            </button>
        </form>
    </div>

    <AdminManager client:load posts={posts} />

    {pagination && (
        <Pagination pagination={pagination} baseUrl="/admin" query={query} pageSize={pageSize} pageSizeOptions={pageSizeOptions} />
    )}
    
</BaseLayout>