---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Pagination from '../../components/Pagination.astro';
import type { Post } from '../../services/api';
import { getPosts } from '../../services/api';

// Fetch posts for admin view
const page = parseInt(Astro.url.searchParams.get('page') || '1', 10);
const data = await getPosts(page);
const posts: Post[] = data?.posts || [];
const pagination = data?.pagination;
const query = Astro.url.searchParams.get('q') || '';

function formatDate(dateString: string) {
  if (!dateString || dateString.startsWith('0001-01-01')) {
    return '—';
  }
  try {
    const date = new Date(dateString);
    if (isNaN(date.getTime())) {
      return '—';
    }
    return date.toISOString().split('T')[0]; // Format as YYYY-MM-DD
  } catch (e) {
    return '—';
  }
}
---
<BaseLayout title="后台管理">
    <div class="admin-header">
        <h2 class="group-title">文章管理</h2>
        <form id="admin-search-form" action="/admin" method="get" class="search-form admin-search-form">
            <input type="search" name="q" placeholder="搜索文章..." class="search-input" value={query}>
            <button type="submit" class="search-button" aria-label="Search">
                <img src="/pic/search.png" alt="Search" class="search-icon">
            </button>
        </form>
    </div>

    <div class="post-list-container">
        <div class="post-list-header">
            <div class="col-checkbox"><input type="checkbox" id="select-all-posts"></div>
            <div class="col-title">标题</div>
            <div class="col-private">私密</div>
            <div class="col-date">发布日期</div>
            <div class="col-actions">操作</div>
        </div>
        <div class="post-list-body">
            {posts.length > 0 ? (
                posts.map(post => (
                    <div class="post-list-item">
                        <div class="col-checkbox"><input type="checkbox" class="post-checkbox" data-id={post.id}></div>
                        <div class="col-title" title={post.title}>
                            <a href={`/post/${post.slug}`}>{post.title}</a>
                        </div>
                        <div class="col-private">
                            {post.is_private ? '是' : '-'}
                        </div>
                        <div class="col-date">
                            {formatDate(post.published_at)}
                        </div>
                        <div class="col-actions">
                            <a href={`/admin/editor?id=${post.id}`}>[编辑]</a>
                            <div class="delete-wrapper" tabindex="0">
                                <span class="delete-init">[删除]</span>
                                <span class="delete-confirm" data-id={post.id}>[确认]</span>
                            </div>
                        </div>
                    </div>
                ))
            ) : (
                <div class="empty-state">
                    {query ? (
                        <p>没有找到与 "{query}" 相关的文章。</p>
                    ) : (
                        <p>没有文章。</p>
                    )}
                </div>
            )}
        </div>
    </div>

    <div class="batch-actions-container">
        <button id="batch-delete-btn" class="btn" disabled>批量删除</button>
        <button id="batch-set-private-btn" class="btn" disabled>设为私密</button>
        <button id="batch-set-public-btn" class="btn" disabled>设为公开</button>
    </div>

    {pagination && (
        <Pagination pagination={pagination} baseUrl="/admin" query={query} />
    )}
    
    <script>
        import '../../scripts/admin.ts';
    </script>
</BaseLayout>