---
import BaseLayout from '../layouts/BaseLayout.astro';

// 从 URL 查询参数中获取可选的错误消息
const { error } = Astro.params;
const errorMessage = Astro.url.searchParams.get('error');
---

<BaseLayout title="页面未找到" description="您要找的页面不存在。">
  <style is:global>
    @import '../styles/404.css';
  </style>
  <div class="not-found-container">
    <h1>404</h1>
    <p>{errorMessage || '哎呀！您要找的页面似乎已经迷失在代码的海洋里了。'}</p>
    <p>也许您可以尝试返回首页，重新开始您的探索之旅。</p>
    <a href="/" class="home-link">返回首页</a>
  </div>
</BaseLayout>