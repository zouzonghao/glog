---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostListView from '../components/PostListView.astro';
import PostCardView from '../components/PostCardView.astro';
import Pagination from '../components/Pagination.astro';
import { searchPosts } from '../services/api';
import type { Post } from '../services/api';

const query = Astro.url.searchParams.get('q');
const view = Astro.url.searchParams.get('view') || 'list';
const page = parseInt(Astro.url.searchParams.get('page') || '1', 10);
const pageSize = 10; // Hardcode page size to 10

import type { PaginatedPostsResponse } from '../services/api';

let posts: Post[] = [];
let pagination: PaginatedPostsResponse['pagination'] | null = null;

if (query) {
    const data = await searchPosts(query, page, pageSize);
    posts = data?.posts || [];
    pagination = data?.pagination;
}

const title = `搜索结果: "${query}"`;
---

<BaseLayout title={title}>
    <div class="posts-group">
        {posts.length === 0 && query ? (
            <>
                <h2 class="group-title">搜索结果: "{query}"</h2>
                <p>没有找到与 "{query}" 相关的文章。</p>
            </>
        ) : (
            view === 'list' ? (
                <PostListView posts={posts} title={`搜索结果: "${query}"`} />
            ) : (
                <PostCardView posts={posts} title={`搜索结果: "${query}"`} />
            )
        )}
    </div>

    {pagination && (
        <Pagination pagination={pagination} baseUrl="/search" query={query || ''} />
    )}
</BaseLayout>