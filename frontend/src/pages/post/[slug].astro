---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPostBySlug, getPosts, type PostDetail } from '../../services/api';
// For now, we'll fetch all posts to generate paths.
// In a larger blog, you might want to fetch only slugs.
export async function getStaticPaths() {
  const { posts } = await getPosts(1, 1000); // Fetch a large number of posts
  return posts.map(post => ({
    params: { slug: post.slug },
  }));
}

const { slug } = Astro.params;
const { isLoggedIn } = Astro.locals;

if (!slug) {
    return new Response('Not Found', { status: 404 });
}

let post: PostDetail | null = null;
let error: string | null = null;
try {
    post = await getPostBySlug(slug, Astro.cookies);
} catch (e) {
    error = '文章加载失败。';
    console.error(e);
}

function formatDate(dateString: string) {
    const date = new Date(dateString);
    const year = date.getFullYear();
    const month = (date.getMonth() + 1).toString().padStart(2, '0');
    const day = date.getDate().toString().padStart(2, '0');
    return `${year}-${month}-${day}`;
}

---

<BaseLayout title={post ? post.title : '文章详情'} description={post ? post.excerpt : ''}>
    <article class="post">
        {post ? (
            <>
                <header class="post-header">
                    <h1 style={`view-transition-name: post-${slug}`}>
                        {post.title}
                        {post.is_private && <span class="private-icon"></span>}
                    </h1>
                    <div class="meta">
                        <span>{formatDate(post.published_at)}</span>
                        {isLoggedIn && (
                            <span class="edit-link" style="margin-left: 10px; gap: 5px;">
                                {'| '}<a href={`/admin/editor?id=${post.id}`} style="margin-left: 8px;">编辑此文章</a>
                            </span>
                        )}
                    </div>
                </header>
                <div class="post-content" set:html={post.content_html} />
            </>
        ) : (
            <p>{error || '文章未找到。'}</p>
        )}
    </article>
</BaseLayout>