---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPostBySlug, getPosts, type PostDetail } from '../../services/api';
import { marked } from 'marked'; // We'll need to install this library

// This function tells Astro which pages to build.
// For now, we'll fetch all posts to generate paths.
// In a larger blog, you might want to fetch only slugs.
export async function getStaticPaths() {
  const { posts } = await getPosts(1, 1000); // Fetch a large number of posts
  return posts.map(post => ({
    params: { slug: post.Slug },
  }));
}

const { slug } = Astro.params;
if (!slug) {
    return new Response('Not Found', { status: 404 });
}

let post: PostDetail | null = null;
let error: string | null = null;
try {
    post = await getPostBySlug(slug);
} catch (e) {
    error = '文章加载失败。';
    console.error(e);
}

// Parse markdown content to HTML
const contentHtml = post ? marked.parse(post.Content) : '';
---

<BaseLayout title={post ? post.Title : '文章详情'} description={post ? post.Excerpt : ''}>
    <article class="post-content">
        {post ? (
            <>
                <header class="post-header">
                    <h1>{post.Title}</h1>
                    <div class="post-meta">
                        <span>发布于 {new Date(post.PublishedAt).toLocaleDateString('zh-CN')}</span>
                    </div>
                </header>
                <div class="prose" set:html={contentHtml} />
            </>
        ) : (
            <p>{error || '文章未找到。'}</p>
        )}
    </article>
</BaseLayout>

<style>
/* Basic styling for the post page */
.post-content {
    max-width: 800px;
    margin: 2rem auto;
    padding: 0 1rem;
}
.post-header {
    margin-bottom: 2rem;
    text-align: center;
}
.post-meta {
    color: #666;
    font-size: 0.9rem;
}
.prose {
    line-height: 1.7;
}
/* Add more styles as needed */
</style>