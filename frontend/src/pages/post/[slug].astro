---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPostBySlug, getPosts, type PostDetail, ApiError } from '../../services/api';


// old 是控制淡出，new 是控制淡入，淡出和淡入不重合导致残影，所以取消一个
const anim = {
  old: {
    name: "zero",
    duration: "0.45s",
    easing: "linear",
    direction: "normal",
    fillMode: "both",
  },
  new: {
    name: "fadeIn",
    duration: "0.45s",
    easing: "linear",
    direction: "normal",
    fillMode: "both",
  }
};

const customFade = {
  forwards: anim,
  backwards: anim,
};

// This function is for SSG, but since we are in SSR mode, it might not be fully utilized
// as intended for every single post. Keeping it might be useful if you switch modes.
export async function getStaticPaths() {
  try {
    const { posts } = await getPosts(1, 1000); // Fetch a large number of posts
    return posts.map(post => ({
      params: { slug: post.slug },
    }));
  } catch (error) {
    console.error("Failed to fetch posts for static paths:", error);
    return []; // Return empty paths if API fails
  }
}

const { slug } = Astro.params;
const { isLoggedIn } = Astro.locals;

if (!slug) {
    return Astro.redirect('/404');
}

let post: PostDetail | null = null;

try {
    post = await getPostBySlug(slug, Astro.cookies);
} catch (e) {
    if (e instanceof ApiError && e.status === 404) {
        return Astro.redirect('/404');
    } else {
        console.error("Error fetching post:", e);
        // Redirect with a generic error message for non-404 errors
        return Astro.redirect('/404?error=文章加载失败');
    }
}

// This is a safeguard. If the API call succeeds but returns no post,
// which shouldn't happen if the API is consistent, redirect to 404.
if (!post) {
    return Astro.redirect('/404?error=未找到文章数据');
}

function formatDate(dateString: string) {
    const date = new Date(dateString);
    const year = date.getFullYear();
    const month = (date.getMonth() + 1).toString().padStart(2, '0');
    const day = date.getDate().toString().padStart(2, '0');
    return `${year}-${month}-${day}`;
}
---
<BaseLayout title={post.title} description={post.excerpt}>
    <link rel="stylesheet" href="/css/prism.css" slot="head">

    <article class="post">
        <header class="post-header">
            <h1 transition:name={`post-${slug}`} transition:animate={customFade}>
                {post.title}
                {post.is_private && <span class="private-icon"></span>}
            </h1>
            <div class="meta">
                <span>{formatDate(post.published_at)}</span>
                {isLoggedIn && (
                    <span class="edit-link" style="margin-left: 10px; gap: 5px;">
                        {'| '}<a href={`/admin/editor?id=${post.id}`} style="margin-left: 8px;">编辑此文章</a>
                    </span>
                )}
            </div>
        </header>
        <div class="post-content" set:html={post.content_html} />
    </article>

    <script src="/js/prism.js" slot="scripts"></script>
    <script is:inline slot="scripts">
        function highlight() {
            if (typeof Prism !== 'undefined') {
                Prism.highlightAll();
            }
        }
        // Run on initial page load
        highlight();
        // Run on subsequent page navigations (Astro View Transitions)
        document.addEventListener('astro:after-swap', highlight);
    </script>
</BaseLayout>