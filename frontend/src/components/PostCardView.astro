---
import type { Post, Pagination } from '../services/api';
import CardViewIslands from './CardViewIslands.svelte';

export interface Props {
  posts: Post[];
  pagination: Pagination;
  title?: string;
  searchQuery?: string | null;
}

const { posts, pagination, title = "全部文章", searchQuery = null } = Astro.props;
---
<div id="home-page" class="cards-view">
    <h2 class="group-title">{title}</h2>
    <CardViewIslands
        client:load
        initialPosts={posts}
        pagination={pagination}
        searchQuery={searchQuery}
    />
</div>