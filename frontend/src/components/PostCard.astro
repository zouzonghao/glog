---
import type { Post } from '../services/api';

export interface Props {
    post: Post;
}

const { post } = Astro.props;
---

<a href={`/post/${post.slug}`} class="post-card" data-title={post.title}>
    <div class="card-cover">
        {post.cover ? (
            <img src={post.cover} alt={post.title} loading="lazy" />
        ) : (
            <div class="pseudo-cover">
                {/* You can add a placeholder SVG or keep it empty for JS to handle */}
            </div>
        )}
    </div>
    <div class="card-info">
        <h3 class="card-title" style={`view-transition-name: post-${post.slug}`}>
            {post.title}
            {post.is_private && <span class="private-icon"></span>}
        </h3>
    </div>
</a>

<style>
    /* Scoped styles from cards.css can be moved here if needed, */
    /* but for now we rely on the global stylesheet. */
    .private-icon {
        display: inline-block;
        width: 16px;
        height: 16px;
        margin-left: 8px;
        background-image: url('/pic/lock.svg');
        background-size: contain;
        vertical-align: middle;
    }

    .dark .private-icon {
        background-image: url('/pic/lock-w.svg');
    }
</style>