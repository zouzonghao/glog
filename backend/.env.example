# --- 服务器配置 ---
# 你的前端应用程序的公共 URL，用于 CORS 策略。
# 在开发环境中，这通常是你的 Astro 开发服务器地址。
FRONTEND_URL=http://localhost:4321

# 会话（Session）Cookie 的域名。对于本地开发，请使用 "localhost"。
# 对于生产环境，请使用你的主域名，前面带一个点（例如，".your-domain.com"）。
COOKIE_DOMAIN=localhost

# 一个长、随机、秘密的字符串，用于保护会话 Cookie。
# 在生产环境中生成一个强密码。
SESSION_SECRET=dev-secret-key-should-be-changed

# --- 数据库配置 ---
# SQLite 数据库文件的路径。
# 如果为空，将在可执行文件所在目录创建 "glog.db" 文件。
DB_PATH=glog.db

# --- Gin 框架模式 ---
# 生产环境请设置为 "release" 以获得更好的性能。
# GIN_MODE=release
